@page "/login"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>Iniciar Sesion - Killa Beauty</PageTitle>

<section class="login-page">
    <div class="login-card">
        <NavLink href="/" class="back-home">
            <i class="bi bi-arrow-left"></i>
            Volver al inicio
        </NavLink>

        <div class="login-icon">
            <img src="Images/ImagenInicio.png" alt="Inicio sesion" />
        </div>

        <h1>Iniciar Sesion</h1>

        <p class="login-subtitle">
            Bienvenido a Killa Beauty
        </p>

        <form method="post" action="/auth/login" id="loginForm" @formname="loginForm">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="form-group">
                <label>Correo Electronico</label>
                <input type="email"
                       name="correoElectronico"
                       placeholder="Ingresa tu correo"
                       required />
            </div>

            <div class="form-group">
                <label>Contrasena</label>
                <div style="position: relative; display: flex; align-items: center; width: 100%;">
                    <input type="password"
                           name="contrasena"
                           placeholder="Ingresa tu contrasena"
                           style="width: 100%; padding-right: 40px;"
                           required />
                </div>
            </div>

            <div class="forgot-password">
                <a href="/forgot-password">Olvidaste tu contrasena?</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="validation-message">Correo o contrasena incorrectos.</p>
            }

            <button type="submit" class="login-button">
                Iniciar Sesion
            </button>
        </form>

        <p class="register-text">
            No tienes cuenta?
            <a href="/register">Registrate aqui</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
