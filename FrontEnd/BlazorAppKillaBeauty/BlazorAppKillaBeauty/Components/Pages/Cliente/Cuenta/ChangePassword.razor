@page "/account/change-password"
@layout AccountLayout
@attribute [Authorize(Roles = "CLIENTE,TRABAJADOR,ADMINISTRADOR")]
@rendermode InteractiveServer

@using BlazorAppKillaBeauty.ClienteREST.Models
@using BlazorAppKillaBeauty.ClienteREST.ServicesAct

@inject AuthService AuthService
@inject UsuarioPasswordService UsuarioPasswordService

<div>
    <h2 class="card-inside-title">Cambia tu contraseña</h2>

    @* Usamos la cuadrícula de perfil para distribuir los campos *@
    <div class="profile-form-grid">
        <div class="form-input-group">
            <label>Contraseña actual</label>
            <div class="password-wrapper">
                <input type="@(isOldPasswordVisible ? "text" : "password")" @bind="oldPassword" class="form-control" placeholder="Ingresa tu contraseña actual" />
                <button type="button" class="password-toggle-btn" @onclick="ToggleOldPasswordVisibility">
                    <i class="bi @(isOldPasswordVisible ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
            @if (showOldPassError)
            {
                <p class="error-hint-text">Contraseña incorrecta</p>
            }
        </div>
        @* Espacio vacío para que 'Contraseña actual' ocupe solo la mitad *@
        <div class="empty-space-block"></div>

        <div class="form-input-group">
            <label>Nueva contraseña</label>
            <div class="password-wrapper">
                <input type="@(isNewPasswordVisible ? "text" : "password")" @bind="newPassword" @bind:event="oninput" class="form-control" placeholder="Ingresa tu nueva contraseña" />
                <button type="button" class="password-toggle-btn" @onclick="ToggleNewPasswordVisibility">
                    <i class="bi @(isNewPasswordVisible ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
            
            <div class="password-hints">
                <p class="@(IsLongEnough ? "hint-valid" : "hint-invalid")">
                    <i class="bi @(IsLongEnough ? "bi-check" : "bi-dot")"></i> *** Mínimo 6 caracteres
                </p>
            </div>
        </div>

        <div class="form-input-group">
            <label>Confirmar nueva contraseña</label>
            <div class="password-wrapper">
                <input type="@(isConfirmPasswordVisible ? "text" : "password")" @bind="confirmPassword" @bind:event="oninput" class="form-control" placeholder="Confirma tu nueva contraseña" />
                <button type="button" class="password-toggle-btn" @onclick="ToggleConfirmPasswordVisibility">
                    <i class="bi @(isConfirmPasswordVisible ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(confirmPassword) && !PasswordsMatch)
            {
                <p class="error-hint-text">Las contraseñas no coinciden</p>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="validation-message text-danger">@errorMessage</p>
    }

    <div class="form-actions-area">
        <button class="killa-save-button @(CanSubmit && !isSaving ? "state-active" : "state-disabled")"
                @onclick="HandleChangePassword"
                disabled="@(isSaving || !CanSubmit)">
            @(isSaving ? "Guardando..." : "Guardar cambios")
        </button>
    </div>
</div>

@if (showSuccessModal)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <h3 class="modal-title-text">¡Éxito!</h3>
            <p class="modal-body-text">Tu contraseña se ha actualizado correctamente.</p>
            <button @onclick="() => showSuccessModal = false" class="killa-save-button state-active modal-accept-btn">Aceptar</button>
        </div>
    </div>
}

@code {
    // Variables de activo para los inputs
    private string oldPassword;
    private string newPassword;
    private string confirmPassword;
    private bool showOldPassError = false;
    private bool isSaving = false;
    private bool showSuccessModal = false;
    private string errorMessage = "";

    // Variables de activo para la visibilidad (ojos)
    private bool isOldPasswordVisible = false;
    private bool isNewPasswordVisible = false;
    private bool isConfirmPasswordVisible = false;

    // Lógica de validación
    private bool IsLongEnough => (newPassword?.Length ?? 0) >= 6;
    
    private bool IsValid => IsLongEnough;
    private bool PasswordsMatch => newPassword == confirmPassword && !string.IsNullOrEmpty(newPassword);
    private bool CanSubmit => IsValid && PasswordsMatch && !string.IsNullOrEmpty(oldPassword);

    // Métodos para alternar visibilidad
    private void ToggleOldPasswordVisibility() => isOldPasswordVisible = !isOldPasswordVisible;
    private void ToggleNewPasswordVisibility() => isNewPasswordVisible = !isNewPasswordVisible;
    private void ToggleConfirmPasswordVisibility() => isConfirmPasswordVisible = !isConfirmPasswordVisible;

    private async Task HandleChangePassword()
    {
        if (AuthService.UsuarioId is null)
        {
            errorMessage = "Inicia sesión para cambiar tu contraseña.";
            return;
        }
        
        isSaving = true;
        showOldPassError = false;
        errorMessage = "";

        try
        {
            await UsuarioPasswordService.CambiarContrasenaAsync(
                AuthService.UsuarioId.Value,
                new CambiarContrasenaRequest
                {
                    ContrasenaActual = oldPassword,
                    NuevaContrasena = newPassword
                });

            showSuccessModal = true;
        
            oldPassword = newPassword = confirmPassword = "";
            isOldPasswordVisible = isNewPasswordVisible = isConfirmPasswordVisible = false; // Resetear visibilidad
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("incorrecta", StringComparison.OrdinalIgnoreCase) ||
                ex.Message.Contains("401", StringComparison.OrdinalIgnoreCase))
            {
                showOldPassError = true;
            }
            else
            {
                errorMessage = ex.Message;
            }
        }
        finally
        {
            isSaving = false;
        }
    }
}
