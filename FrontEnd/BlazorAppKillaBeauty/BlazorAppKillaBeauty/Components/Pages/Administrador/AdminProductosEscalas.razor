@page "/admin/productos/{Codigo}/escalas"
@attribute [Authorize(Roles = "ADMINISTRADOR,TRABAJADOR")]
@rendermode InteractiveServer
@using BlazorAppKillaBeauty.Services
@using BlazorAppKillaBeauty.ClienteREST.Models
@using BlazorAppKillaBeauty.ClienteREST.ServicesAct
@inject NavigationManager Navigation
@inject ProductoService ProductoService
@inject EscalaPrecioService EscalaPrecioService

<PageTitle>Escalas de precio - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-scales-content">

        <header class="admin-scales-header">
            <div>
                <h1>Escalas de precio · @producto.Nombre</h1>
            </div>

            <div class="admin-scales-header-actions">
                <button type="button" class="btn-scales-back" @onclick="VolverAlProducto">
                    <i class="bi bi-arrow-left"></i>
                    Volver al producto
                </button>

                <button type="button" class="btn-scales-add" @onclick="AbrirAgregar">
                    <i class="bi bi-plus-circle"></i>
                    Agregar escala
                </button>
            </div>
        </header>

        <section class="admin-scales-subinfo">
            <div class="subinfo-row">
                <span>Producto: <strong>@producto.Nombre</strong></span>
                <span>Precio base: <strong>S/. @producto.PrecioBase.ToString("F2")</strong></span>
                <span>Stock: <strong class="stock-pill">@producto.Stock u.</strong></span>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="admin-products-alert">
                <span><i class="bi bi-exclamation-circle-fill"></i> @mensajeError</span>
                <button type="button" @onclick="() => mensajeError = null">X</button>
            </div>
        }

        <section class="admin-scales-table-card">
            <table class="admin-scales-table">
                <thead>
                    <tr>
                        <th>Nombre escala</th>
                        <th>Cantidad minima</th>
                        <th>Precio unitario (S/)</th>
                        <th>Descuento vs. base</th>
                        <th>Estado</th>
                        <th style="text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in escalas.OrderBy(x => x.CantidadMinima))
                    {
                        <tr>
                            <td class="td-strong">@NombreEscala(e.CantidadMinima)</td>
                            <td>@e.CantidadMinima unidad</td>
                            <td>S/. @e.PrecioUnitario.ToString("F2")</td>
                            <td>@CalcularDescuentoTexto(e)</td>
                            <td>
                                <span class="pill-state @(e.Activo ? "pill-active" : "pill-inactive")">
                                    @(e.Activo ? "Activa" : "Inactiva")
                                </span>
                            </td>
                            <td style="text-align:right;">
                                <div class="scales-actions">
                                    <button type="button" class="btn-scale-outline" @onclick="() => AbrirEditar(e)">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>

                                    <button type="button" class="btn-scale-outline" @onclick="() => AbrirEliminar(e)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (escalas.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty-orders">
                                    <i class="bi bi-inbox"></i>
                                    <span>No hay escalas registradas.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <footer class="admin-scales-footer">
            <button type="button" class="btn-scales-back" @onclick="VolverAlProducto">
                <i class="bi bi-arrow-left"></i>
                Volver al producto
            </button>

            <button type="button" class="btn-scales-add" @onclick="AbrirAgregar">
                <i class="bi bi-plus-circle"></i>
                Agregar escala
            </button>
        </footer>

    </section>
</main>

@if (mostrarModalFormulario)
{
    <div class="scales-modal-overlay">
        <div class="scales-modal-card">
            <header class="scales-modal-header">
                <h2>
                    <i class="bi bi-plus-lg"></i>
                    @(modoFormulario == "crear" ? "Agregar nueva escala" : "Editar escala")
                </h2>
            </header>

            <div class="scales-modal-body">
                <div class="scales-form-field">
                    <label>Cantidad minima <span class="req">*</span></label>
                    <input type="number" placeholder="Ej: 24" @bind="form.CantidadMinima" />
                    <small>Minimo de unidades para aplicar este precio.</small>
                </div>

                <div class="scales-form-field">
                    <label>Precio unitario (S/) <span class="req">*</span></label>
                    <input type="number" step="0.01" placeholder="0.00" @bind="form.PrecioUnitario" />
                    <small>Debe ser menor al precio base.</small>
                </div>
            </div>

            <footer class="scales-modal-actions">
                <button type="button" class="btn-scale-cancel" @onclick="CerrarFormulario">
                    Cancelar
                </button>
                <button type="button" class="btn-scale-save" @onclick="GuardarEscala">
                    Guardar escala
                </button>
            </footer>
        </div>
    </div>
}

@if (mostrarModalEliminar && escalaSeleccionada != null)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal-card">
            <div class="admin-modal-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2>¿Eliminar escala?</h2>
            <p class="admin-modal-text">
                Se eliminará la escala <strong>@NombreEscala(escalaSeleccionada.CantidadMinima)</strong>.
            </p>
            <div class="admin-modal-actions">
                <button class="admin-modal-btn-cancel" @onclick="CerrarEliminar">Cancelar</button>
                <button class="admin-modal-btn-confirm" @onclick="ConfirmarEliminar">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Codigo { get; set; } = "";

    private string? mensajeError;

    private ProductoResumen producto = new();
    private List<EscalaPrecio> escalas = new();
    private int productoId;

    private bool mostrarModalFormulario = false;
    private bool mostrarModalEliminar = false;
    private string modoFormulario = "crear"; // crear | editar
    private EscalaPrecio? escalaSeleccionada;

    private EscalaForm form = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productoId = ObtenerIdProducto();
            var productoApi = await ProductoService.ObtenerPorIdAsync(productoId);
            producto = productoApi == null
                ? new ProductoResumen(Codigo, $"Producto {Codigo}", 0m, 0)
                : new ProductoResumen($"KB-{productoApi.Id:000}", productoApi.Nombre, productoApi.PrecioBase, productoApi.Stock);
            await CargarEscalas();
        }
        catch (Exception ex)
        {
            producto = new ProductoResumen(Codigo, $"Producto {Codigo}", 0m, 0);
            mensajeError = $"No se pudieron cargar las escalas: {ex.Message}";
        }
    }

    private async Task CargarEscalas()
    {
        escalas = (await EscalaPrecioService.ListarPorProductoAsync(productoId))
            .OrderBy(e => e.CantidadMinima)
            .ToList();
    }

    private int ObtenerIdProducto()
    {
        if (int.TryParse(Codigo, out var id))
        {
            return id;
        }

        if (Codigo.StartsWith("KB-", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(Codigo[3..], out var codigoId))
        {
            return codigoId;
        }

        return 0;
    }

    private void VolverAlProducto() => Navigation.NavigateTo($"/admin/productos/{Codigo}");

    private void AbrirAgregar()
    {
        mensajeError = null;
        modoFormulario = "crear";
        escalaSeleccionada = null;
        form = new EscalaForm();
        mostrarModalFormulario = true;
    }

    private void AbrirEditar(EscalaPrecio e)
    {
        mensajeError = null;
        modoFormulario = "editar";
        escalaSeleccionada = e;

        form = new EscalaForm
        {
            CantidadMinima = e.CantidadMinima,
            PrecioUnitario = e.PrecioUnitario
        };

        mostrarModalFormulario = true;
    }

    private void CerrarFormulario() => mostrarModalFormulario = false;

    private async Task GuardarEscala()
    {
        if (form.CantidadMinima <= 0)
        {
            mensajeError = "La cantidad minima debe ser mayor a 0.";
            return;
        }

        if (form.PrecioUnitario <= 0)
        {
            mensajeError = "El precio unitario debe ser mayor a 0.";
            return;
        }

        if (form.PrecioUnitario > producto.PrecioBase)
        {
            mensajeError = "El precio unitario debe ser menor o igual al precio base.";
            return;
        }

        // Evitar duplicados de cantidad minima
        if (modoFormulario == "crear" && escalas.Any(x => x.CantidadMinima == form.CantidadMinima))
        {
            mensajeError = "Ya existe una escala con esa cantidad minima.";
            return;
        }

        try
        {
            if (modoFormulario == "editar" && escalaSeleccionada != null)
            {
                var existeOtro = escalas.Any(x => x.Id != escalaSeleccionada.Id && x.CantidadMinima == form.CantidadMinima);
                if (existeOtro)
                {
                    mensajeError = "Ya existe otra escala con esa cantidad minima.";
                    return;
                }

                var escala = CrearEscalaDesdeFormulario(escalaSeleccionada.Id);
                var actualizada = await EscalaPrecioService.ActualizarAsync(escalaSeleccionada.Id, escala);
                if (actualizada == null)
                {
                    throw new InvalidOperationException("No se recibio respuesta al actualizar la escala.");
                }
            }
            else
            {
                var creada = await EscalaPrecioService.CrearAsync(CrearEscalaDesdeFormulario(0));
                if (creada == null)
                {
                    throw new InvalidOperationException("No se recibio respuesta al crear la escala.");
                }
            }

            await CargarEscalas();
            mensajeError = null;
            mostrarModalFormulario = false;
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar la escala: {ex.Message}";
        }
    }

    private EscalaPrecio CrearEscalaDesdeFormulario(int id)
    {
        return new EscalaPrecio
        {
            Id = id,
            CantidadMinima = form.CantidadMinima,
            PrecioUnitario = form.PrecioUnitario,
            Activo = true,
            Producto = new ProductoRef { Id = productoId }
        };
    }

    private void AbrirEliminar(EscalaPrecio e)
    {
        escalaSeleccionada = e;
        mostrarModalEliminar = true;
    }

    private void CerrarEliminar()
    {
        mostrarModalEliminar = false;
        escalaSeleccionada = null;
    }

    private async Task ConfirmarEliminar()
    {
        try
        {
            if (escalaSeleccionada != null)
            {
                await EscalaPrecioService.EliminarAsync(escalaSeleccionada.Id);
                await CargarEscalas();
            }
            CerrarEliminar();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo eliminar la escala: {ex.Message}";
            mostrarModalEliminar = false;
        }
    }

    private string CalcularDescuentoTexto(EscalaPrecio e)
    {
        if (e.CantidadMinima == 1) return "—";
        if (producto.PrecioBase <= 0) return "—";

        var pct = (double)(1 - (e.PrecioUnitario / producto.PrecioBase)) * 100.0;
        var rounded = (int)Math.Round(pct);

        if (rounded == 0) return "—";
        if (rounded > 0) return $"-{rounded}%";
        return $"+{Math.Abs(rounded)}%";
    }

    private record ProductoResumen(string Codigo, string Nombre, decimal PrecioBase, int Stock)
    {
        public ProductoResumen() : this("", "", 0m, 0) { }
    }

    private static string NombreEscala(int cantidadMinima)
    {
        return cantidadMinima <= 1
            ? "Precio unitario"
            : $"Desde {cantidadMinima} unidades";
    }

    private class EscalaForm
    {
        public int CantidadMinima { get; set; }
        public decimal PrecioUnitario { get; set; }
    }
}
