@page "/admin/marcas"
@page "/admin/marcas/{Accion}"
@page "/admin/marcas/{Accion}/{IdParam:int}"
@attribute [Authorize(Roles = "ADMINISTRADOR,TRABAJADOR")]
@rendermode InteractiveServer

@using BlazorAppKillaBeauty.Services
@using BlazorAppKillaBeauty.ClienteREST.ServicesAct
@using BlazorAppKillaBeauty.ClienteREST.Models
@inject MarcaService MarcaService
@inject PaisService PaisService
@inject NavigationManager NavManager

<PageTitle>Marcas Admin - Killa Beauty</PageTitle>

<main class="admin-page">
    <AdminNavbar />

    <section class="admin-content admin-orders-content">
        <div class="admin-breadcrumb">
            <span>Administrador</span>
            <i class="bi bi-chevron-right"></i>
            <span>Marcas</span>
        </div>

        <header class="admin-header admin-orders-header d-flex justify-content-between align-items-center">
            <div>
                <h1>Gestión de Marcas</h1>
                <p>Consulta y filtra las marcas registradas en la tienda.</p>
            </div>
            <button class="btn-add-marca" @onclick='() => NavManager.NavigateTo("/admin/marcas/nuevo")'>
                + Agregar Marca
            </button>
        </header>

        <section class="admin-orders-filters">
            <div class="admin-orders-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Buscar por descripcion..."
                       @bind="filtroNombre" @bind:event="oninput" @bind:after="AplicarFiltros" />
            </div>

            <div class="admin-orders-filter-row marcas-filter-grid">
                <div class="admin-status-filter">
                    <span>Estado :</span>
                    <select @bind="filtroEstado" @bind:after="AplicarFiltros">
                        <option value="Todos">Todos</option>
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>

                <div class="admin-status-filter">
                    <span>Paí­s :</span>
                    <select @bind="filtroPais" @bind:after="AplicarFiltros">
                        <option value="Todos">Todos</option>
                        @foreach (var pais in paises)
                        {
                            <option value="@pais.Codigo">@pais.Descripcion</option>
                        }
                    </select>
                </div>

                <div class="marcas-sort-container">
                    <span class="sort-label">Ordenar por : <span class="badge-count">Cantidad productos</span></span>
                    <div class="marcas-sort-buttons">
                        <button type="button" class="@(ordenAscendente ? "active" : "")" @onclick="() => CambiarOrden(true)">
                            @if (ordenAscendente)
                            {
                                <i class="bi bi-check2"></i>
                            }
                            De menor a mayor
                        </button>
                        <button type="button" class="@(!ordenAscendente ? "active" : "")" @onclick="() => CambiarOrden(false)">
                            @if (!ordenAscendente)
                            {
                                <i class="bi bi-check2"></i>
                            }
                            De mayor a menor
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <section class="admin-table-card admin-orders-table-card">
            <PaginatedTable TItem="Marca"
                            Page="paginaMarcas"
                            OnChanged="OnPageChanged"
                            ColSpan="5"
                            InitialPageSize="6"
                            PageSizeOptions="opcionesPagina"
                            ContainerClass="table-responsive"
                            TableClass="admin-table admin-orders-table"
                            HeaderClass=""
                            EmptyMessage="No se encontraron marcas.">
                <TableHeader>
                    <tr>
                        <th>ID</th>
                        <th>NOMBRE</th>
                        <th>PAIS DE ORIGEN</th>
                        <th>ESTADO</th>
                        <th class="text-end">ACCIONES</th>
                    </tr>
                </TableHeader>
                <RowTemplate Context="m">
                    <tr>
                        <td style="color: #777;">@m.Id.ToString("D5")</td>
                        <td style="font-weight: 800; color: #4f4148;">@m.Descripcion</td>
                        <td>@ObtenerDescripcionPais(m.Pais)</td>
                        <td>
                            <span class="admin-status @(m.Activo ? "success" : "danger")">
                                @(m.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn-action-icon edit" @onclick='() => NavManager.NavigateTo($"/admin/marcas/editar/{m.Id}")'>
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn-action-icon delete" @onclick='() => NavManager.NavigateTo($"/admin/marcas/eliminar/{m.Id}")'>
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </RowTemplate>
            </PaginatedTable>
        </section>
    </section>
</main>


@if (showModalForm)
{
    <div class="admin-modal-overlay">
        <div class="admin-modal-card">
            <div class="modal-content-kb">
                <h3 class="modal-title-kb">@(EsEdicion ? "Editar Marca" : "Registrar Nueva Marca")</h3>

                <EditForm Model="marcaActual" OnValidSubmit="GuardarCambiosAsync">
                    @if (EsEdicion)
                    {
                        <div class="mb-3">
                            <label class="form-label-kb">ID Marca</label>
                            <input type="text" class="form-control-pill" disabled value="@marcaActual.Id.ToString("D5")" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label-kb">Nombre de la Marca</label>
                        <InputText @bind-Value="marcaActual.Descripcion" class="form-control-pill" placeholder="Ej: THE ORDINARY" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-kb">Paí­s de origen</label>
                        <InputSelect @bind-Value="marcaActual.Pais" class="form-control-pill">
                            @foreach (var pais in paises)
                        {
                            <option value="@pais.Codigo">@pais.Descripcion</option>
                        }
                        </InputSelect>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-kb">Logo de la Marca</label>
                        <div class="logo-upload-area">
                            <i class="bi bi-upload"></i>
                            <span>Cargar Logo</span>
                        </div>
                    </div>

                    <div class="modal-actions-kb">
                        <button type="button" class="btn-modal-cancel" @onclick='() => NavManager.NavigateTo("/admin/marcas")'>Cancelar</button>
                        <button type="submit" class="btn-modal-confirm">@(EsEdicion ? "Guardar Cambios" : "Agregar Marca")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (showModalDelete && marcaAEliminar != null)
{
    <div class="modal fade show d-block modal-overlay" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-content-kb" style="padding: 2.5rem;">
                <h3 class="modal-title-kb" style="margin-bottom: 1rem;">Â¿Eliminar Marca?</h3>

                <div class="delete-modal-info">
                    ID @marcaAEliminar.Id.ToString("D2") | Marca : @marcaAEliminar.Descripcion.ToUpper() | Productos Asociados 0
                </div>

                <div class="delete-modal-warning">
                    Esta accion desactivara la marca.<br />
                    Los productos existentes perderan la referencia a<br />
                    la marca pero podran seguir vendiendose.
                </div>

                <div class="modal-actions-kb" style="margin-top: 30px;">
                    <button type="button" class="btn-modal-cancel" @onclick='() => NavManager.NavigateTo("/admin/marcas")'>Cancelar</button>
                    <button type="button" class="btn-modal-confirm" @onclick="ConfirmarEliminacionAsync">Confirmar Eliminacion</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Accion { get; set; }
    [Parameter] public int? IdParam { get; set; }

    private IReadOnlyList<Marca> marcasBD = new List<Marca>();
    private List<PaisOpcion> paises = new();

    private Marca marcaActual = new Marca { Activo = true };
    private Marca? marcaAEliminar;
    private bool showModalForm = false;
    private bool showModalDelete = false;
    private bool EsEdicion = false;
    private bool datosCargados = false;
    private string? mensajeError;

    private string filtroNombre = "";
    private string filtroEstado = "Todos";
    private string filtroPais = "Todos";
    private bool ordenAscendente = true;

    private readonly int[] opcionesPagina = new[] { 6, 10, 25, 50, 100 };
    private PageQuery queryActual = new(1, 6);
    private TablePage<Marca> paginaMarcas = new();
    private List<Marca> marcasFiltradas = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!datosCargados)
        {
            await CargarDatosAsync();
        }

        ConfigurarModalDesdeRuta();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            paises = await PaisService.ListarTodosAsync();
            marcasBD = await MarcaService.ListarTodasAsync();
            datosCargados = true;
            mensajeError = null;
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudieron cargar las marcas: {ex.Message}";
            marcasBD = new List<Marca>();
            marcasFiltradas = new List<Marca>();
        }
    }

    private void ConfigurarModalDesdeRuta()
    {
        showModalForm = false;
        showModalDelete = false;
        marcaAEliminar = null;

        if (Accion == "nuevo")
        {
            marcaActual = new Marca { Activo = true, Pais = paises.FirstOrDefault()?.PaisEnum ?? Pais.EEUU };
            EsEdicion = false;
            showModalForm = true;
        }
        else if (Accion == "editar" && IdParam.HasValue)
        {
            var bd = marcasBD.FirstOrDefault(m => m.Id == IdParam.Value);
            if (bd != null)
            {
                marcaActual = new Marca { Id = bd.Id, Descripcion = bd.Descripcion, Pais = bd.Pais, Activo = bd.Activo };
                EsEdicion = true;
                showModalForm = true;
            }
        }
        else if (Accion == "eliminar" && IdParam.HasValue)
        {
            marcaAEliminar = marcasBD.FirstOrDefault(m => m.Id == IdParam.Value);
            if (marcaAEliminar != null) showModalDelete = true;
        }
    }

    private async Task RefrescarTablaAsync()
    {
        marcasBD = await MarcaService.ListarTodasAsync();
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var q = marcasBD.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(filtroNombre))
            q = q.Where(m => m.Descripcion.Contains(filtroNombre.Trim(), StringComparison.OrdinalIgnoreCase));

        if (filtroEstado != "Todos")
            q = q.Where(m => m.Activo == (filtroEstado == "Activo"));

        if (filtroPais != "Todos")
            q = q.Where(m => m.Pais.ToString() == filtroPais);

        if (ordenAscendente) q = q.OrderBy(m => m.Descripcion);
        else q = q.OrderByDescending(m => m.Descripcion);

        marcasFiltradas = q.ToList();
        ResetearPaginacion();
    }

    private string ObtenerDescripcionPais(Pais pais)
    {
        return paises.FirstOrDefault(p => p.Codigo == pais.ToString())?.Descripcion ?? pais.ToString();
    }

    private void CambiarOrden(bool ascendente) { ordenAscendente = ascendente; AplicarFiltros(); }

    private void OnPageChanged(PageQuery query)
    {
        queryActual = query;
        ActualizarPaginaMarcas();
    }

    private void ResetearPaginacion()
    {
        queryActual = new PageQuery(1, queryActual.PageSize);
        ActualizarPaginaMarcas();
    }

    private void ActualizarPaginaMarcas()
    {
        paginaMarcas = new TablePage<Marca>
        {
            Items = marcasFiltradas
                .Skip((queryActual.Page - 1) * queryActual.PageSize)
                .Take(queryActual.PageSize)
                .ToList(),
            TotalRecords = marcasFiltradas.Count
        };
    }

    private async Task GuardarCambiosAsync()
    {
        try
        {
            if (EsEdicion)
            {
                await MarcaService.ActualizarMarcaAsync(marcaActual);
            }
            else
            {
                marcaActual.Activo = true;
                await MarcaService.CrearAsync(marcaActual);
            }

            await RefrescarTablaAsync();
            NavManager.NavigateTo("/admin/marcas");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar la marca: {ex.Message}";
        }
    }

    private async Task ConfirmarEliminacionAsync()
    {
        if (marcaAEliminar != null)
        {
            try
            {
                await MarcaService.EliminarMarcaAsync(marcaAEliminar.Id);
                await RefrescarTablaAsync();
            }
            catch (Exception ex)
            {
                mensajeError = $"No se pudo desactivar la marca: {ex.Message}";
            }
        }
        NavManager.NavigateTo("/admin/marcas");
    }
}
