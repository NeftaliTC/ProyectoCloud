@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var relativeUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativeUrl) ? "/" : "/" + relativeUrl;
        NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
