@typeparam TItem

<div class="killa-paginated-table">
    @if (ShowTopControls)
    {
        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
            @RenderPageSizeSelector
            <span class="text-muted small">@SummaryRecords</span>
            @RenderPagination
        </div>
    }

    @if (ItemsTemplate is not null)
    {
        @if (Page.Items.Any())
        {
            @ItemsTemplate(Page.Items)
        }
        else
        {
            <div class="@EmptyContainerClass">
                <i class="bi bi-inbox me-2"></i>@EmptyMessage
            </div>
        }
    }
    else
    {
        <div class="@ContainerClass">
            <table class="@TableClass">
                <thead class="@HeaderClass">
                    @TableHeader
                </thead>
                <tbody>
                    @if (Page.Items.Any())
                    {
                        @foreach (var item in Page.Items)
                        {
                            @RowTemplate(item)
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@ColSpan" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox me-2"></i>@EmptyMessage
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
        @RenderPageSizeSelector
        <span class="text-muted small">@SummaryWithPage</span>
        @RenderPagination
    </div>
</div>

@code {
    [Parameter] public TablePage<TItem> Page { get; set; } = new();
    [Parameter] public RenderFragment? TableHeader { get; set; }
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public RenderFragment<List<TItem>>? ItemsTemplate { get; set; }
    [Parameter] public EventCallback<PageQuery> OnChanged { get; set; }
    [Parameter] public int ColSpan { get; set; } = 5;
    [Parameter] public string EmptyMessage { get; set; } = "No se encontraron registros.";
    [Parameter] public string EmptyContainerClass { get; set; } = "text-center py-5 text-muted";
    [Parameter] public string ContainerClass { get; set; } = "table-responsive shadow-sm rounded";
    [Parameter] public string TableClass { get; set; } = "table table-hover align-middle mb-0 bg-white";
    [Parameter] public string HeaderClass { get; set; } = "table-dark";
    [Parameter] public int InitialPageSize { get; set; } = 3;
    [Parameter] public int[] PageSizeOptions { get; set; } = new[] { 3, 10, 25, 50, 100 };
    [Parameter] public string RecordLabel { get; set; } = "registros";
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;
    [Parameter] public bool ShowTopControls { get; set; } = true;

    private int pageSize;
    private int currentPage = 1;
    private TablePage<TItem>? previousPage;
    private bool isNavigatingInternally;
    private bool initialized;
    private List<int> visiblePages = new();

    private int TotalPages => Page.TotalRecords > 0
        ? (int)Math.Ceiling(Page.TotalRecords / (double)pageSize)
        : 1;

    private int StartRecord => Page.TotalRecords > 0 ? (currentPage - 1) * pageSize + 1 : 0;
    private int EndRecord => Math.Min(currentPage * pageSize, Page.TotalRecords);

    private string SummaryRecords => Page.TotalRecords > 0
        ? $"Mostrando {StartRecord}-{EndRecord} de {Page.TotalRecords} {RecordLabel}"
        : $"Sin {RecordLabel}";

    private string SummaryWithPage => Page.TotalRecords > 0
        ? $"Mostrando {StartRecord}-{EndRecord} de {Page.TotalRecords} {RecordLabel} - Pagina {currentPage} de {TotalPages}"
        : $"Sin {RecordLabel}";

    protected override void OnParametersSet()
    {
        if (!initialized)
        {
            pageSize = InitialPageSize;
            initialized = true;
        }

        if (!ReferenceEquals(Page, previousPage))
        {
            previousPage = Page;
            if (isNavigatingInternally)
            {
                isNavigatingInternally = false;
            }
            else
            {
                currentPage = 1;
            }

            if (currentPage > TotalPages)
            {
                currentPage = TotalPages;
            }

            UpdateVisiblePages();
        }
    }

    private void UpdateVisiblePages()
    {
        const int window = 2;
        var start = Math.Max(1, currentPage - window);
        var end = Math.Min(TotalPages, currentPage + window);
        visiblePages = Enumerable.Range(start, end - start + 1).ToList();
    }

    private Task FireChanged()
    {
        isNavigatingInternally = true;
        return OnChanged.InvokeAsync(new PageQuery(currentPage, pageSize));
    }

    private async Task ChangePageSize()
    {
        currentPage = 1;
        await FireChanged();
    }

    private async Task GoToFirst()
    {
        currentPage = 1;
        await FireChanged();
    }

    private async Task GoToPrevious()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
        await FireChanged();
    }

    private async Task GoToNext()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
        await FireChanged();
    }

    private async Task GoToLast()
    {
        currentPage = TotalPages;
        await FireChanged();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await FireChanged();
    }

    private RenderFragment RenderPageSizeSelector => __builder =>
    {
        @if (ShowPageSizeSelector)
        {
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 text-muted small fw-bold">Registros por pagina:</label>
                <select class="form-select form-select-sm" style="width: auto;"
                        @bind="pageSize" @bind:after="ChangePageSize">
                    @foreach (var option in PageSizeOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>
        }
    };

    private RenderFragment RenderPagination => __builder =>
    {
        <nav aria-label="Paginacion de registros">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="GoToFirst" title="Primera pagina">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                </li>
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="GoToPrevious" title="Pagina anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </li>
                @foreach (var num in visiblePages)
                {
                    <li class="page-item @(num == currentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(num)">@num</button>
                    </li>
                }
                <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="GoToNext" title="Pagina siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </li>
                <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="GoToLast" title="Ultima pagina">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                </li>
            </ul>
        </nav>
    };
}
